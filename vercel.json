{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 3008,
        "includeFiles": [
          "node_modules/@sparticuz/chromium-min/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/v1/hianime/(.*)", "dest": "/src/server.js" },
    { "src": "/api/v1/hentai/(.*)", "dest": "/src/server.js" },
    { "src": "/api/v1/animesama/(.*)", "dest": "/src/server.js" },
    { "src": "/api/v1", "dest": "/src/server.js" },
    { "src": "/", "dest": "/src/server.js" }
  ]
}